<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="Atomcraft">
            <HintPath>$(GameInstallDir)\data_Atomcraft_windows_x86_64\Atomcraft.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="GodotSharp">
            <HintPath>$(GameInstallDir)\data_Atomcraft_windows_x86_64\GodotSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(GameInstallDir)\data_Atomcraft_windows_x86_64\Newtonsoft.Json.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    </ItemGroup>

    <PropertyGroup>
        <GDScriptsDir>$(ProjectDir)GDScripts</GDScriptsDir>
        <DataDir>$(ProjectDir)Data</DataDir>
    </PropertyGroup>
    <ItemGroup>
        <GDScripts Include="$(GDScriptsDir)\**\*" />
        <Data Include="$(DataDir)\**\*" />
    </ItemGroup>



    <Target Name="CreateModZip" AfterTargets="Build">

        <PropertyGroup>
            <ModName>$(ProjectName)</ModName>
            <ModDir>$(TargetDir)$(ModName)</ModDir>
            <ModZip>$(ProjectDir)../Release/$(ModName).zip</ModZip>
        </PropertyGroup>

        <RemoveDir Directories="$(ModDir)" />

        <MakeDir Directories="$(ModDir)" />

        <Copy
                SourceFiles="$(TargetPath)"
                DestinationFolder="$(ModDir)/$(ModName)" />

        <Copy   Condition="Exists($(DataDir))"
                SourceFiles="@(Data)"
                DestinationFiles="@(Data->'$(ModDir)/$(ModName)/Data/%(RecursiveDir)%(Filename)%(Extension)')"/>

        <Copy
                SourceFiles="$(ProjectDir)mod.json"
                DestinationFolder="$(ModDir)/$(ModName)" />

        <Delete Files="$(ModZip)" />

        <ZipDirectory
                SourceDirectory="$(ModDir)"
                DestinationFile="$(ModZip)"
                Overwrite="true" />

        <RemoveDir Directories="$(ModDir)" />

        <Message
                Importance="high"
                Text="Mod ZIP created: $(ModZip)" />

    </Target>

    <Target Name="InstallModZip" AfterTargets="Build">

        <PropertyGroup>
            <InstallDir>$(AppData)/Godot/app_userdata/Atomcraft/Mods</InstallDir>
        </PropertyGroup>

        <Delete Files="$(InstallDir)/$(ModName).zip" />

        <Copy
                SourceFiles="$(ModZip)"
                DestinationFolder="$(InstallDir)" />

        <Message
                Importance="high"
                Text="Mod ZIP installed: $(InstallDir)/$(ProjectName).zip" />

    </Target>


</Project>
